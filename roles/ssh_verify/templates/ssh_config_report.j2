=== Проверка параметров (эффективная конфигурация, sshd -T) ===
{% set ns = namespace(failed=0) %}
{% for name, expected in ssh_hardening_expected.items() %}
{% set actual = effective[name | lower] | default('(отсутствует)') %}
{% set ok = (actual | lower) == (expected | lower) %}
{% if not ok %}{% set ns.failed = ns.failed + 1 %}{% endif %}
{{ '%-28s' | format(name) }} значение: {{ '%-30s' | format(actual) }} требуется: {{ '%-15s' | format(expected) }} [{{ 'OK' if ok else 'FAIL' }}]
{% endfor %}
{% set allowusers_values = sshd_effective_config.stdout_lines | select('match', '^allowusers ') | map('regex_replace', '^allowusers\\s+(.*)$', '\\1') | list %}
{% set allowusers_ok = (allowusers_values | sort) == ssh_expected_allow_users %}
{% if not allowusers_ok %}{% set ns.failed = ns.failed + 1 %}{% endif %}
{{ '%-28s' | format('AllowUsers') }} значение: {{ '%-30s' | format(allowusers_values | join(' ')) }} требуется: {{ '%-15s' | format(ssh_expected_allow_users | join(' ')) }} [{{ 'OK' if allowusers_ok else 'FAIL' }}]
{% set acceptenv_values = sshd_effective_config.stdout_lines | select('match', '^acceptenv ') | map('regex_replace', '^acceptenv\\s+(.*)$', '\\1') | list %}
{% set acceptenv_ok = ('LANG' in acceptenv_values) and ('LC_*' in acceptenv_values) %}
{% if not acceptenv_ok %}{% set ns.failed = ns.failed + 1 %}{% endif %}
{{ '%-28s' | format('AcceptEnv') }} значение: {{ '%-30s' | format(acceptenv_values | join(' ')) }} требуется: {{ '%-15s' | format(ssh_hardening_accept_env) }} [{{ 'OK' if acceptenv_ok else 'FAIL' }}]
{% set subsystem_actual = effective['subsystem'] | default('(отсутствует)') %}
{% set subsystem_ok = subsystem_actual == ssh_hardening_sftp_subsystem %}
{% if not subsystem_ok %}{% set ns.failed = ns.failed + 1 %}{% endif %}
{{ '%-28s' | format('Subsystem sftp') }} значение: {{ '%-30s' | format(subsystem_actual) }} требуется: {{ '%-15s' | format(ssh_hardening_sftp_subsystem) }} [{{ 'OK' if subsystem_ok else 'FAIL' }}]

